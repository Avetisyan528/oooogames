# Generate your private password and .env file using npm run admin:setup.
ADMIN_PASSWORD_HASH=
# Production only: exact public origin, without a path or trailing slash.
PUBLIC_ORIGIN=
API_PORT=3001
HOST=127.0.0.1
# Optional frontend override. Rebuild after changing; do not put secrets in REACT_APP_ variables.
REACT_APP_API_URL=/api

